{
  "name": "@codemolabs/brave-music",
  "productName": "brave-music",
  "version": "1.0.19-r",
  "description": "Brave Music OTT Platform - Ad-free YouTube Music, Native Rust/WebKitGTK Runtime & Offline Audio Engine",
  "scripts": {
    "start": "bash run.sh",
    "test": "cargo test --manifest-path crates/brave-music-core/Cargo.toml && cargo test --manifest-path tauri-preview/src-tauri/Cargo.toml",
    "build:rust": "cargo build --release --manifest-path tauri-preview/src-tauri/Cargo.toml",
    "build:snap": "bash Install/Linux/build-snap.sh",
    "build:deb": "bash Install/Linux/build-deb.sh",
    "build:all": "bash Install/Linux/build-deb.sh && bash Install/Linux/build-snap.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemolabs/Brave-Music.git"
  },
  "bugs": {
    "url": "https://github.com/codemolabs/Brave-Music/issues"
  },
  "homepage": "https://github.com/codemolabs/Brave-Music#readme",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "crates/",
    "tauri-preview/",
    "backend/",
    "src/",
    "run.sh",
    "LICENSE",
    "README.md"
  ],
  "author": "Codemo Open Source Labs <cosl@codemoteams.org>",
  "license": "GPL-3.0-or-later"
}
