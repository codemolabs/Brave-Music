<Window
    x:Class="BraveMusic.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Brave Music Setup Suite (v1.0.18)">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Padding="36,28,36,28" RowDefinitions="Auto,*,Auto">
        <!-- Header Zone: Logo, Title, COSL Label -->
        <StackPanel Grid.Row="0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="12" Background="#1B1C24" BorderBrush="rgba(255,255,255,0.1)" BorderThickness="1">
                    <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="#FB542B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Brave Music for Windows" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" FontSize="22"/>
                    <TextBlock Text="Codemo Open Source Labs • Ad-Free YouTube &amp; Spotify OTT • Local Player" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <MenuFlyoutSeparator Margin="0,16,0,8" />
        </StackPanel>

        <!-- Main Body: Downloading Suite & Feature Overview -->
        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
            <!-- WinUI 3 InfoBar -->
            <InfoBar x:Name="DeploymentInfoBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Ready for Installation"
                     Message="Package deployment powered by Windows App SDK (PackageDeploymentManager). No telemetry, 100% user-end." />

            <TextBlock x:Name="StatusTextBlock"
                       Text="Click 'Install Brave Music' to begin package onboarding and runtime deployment."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- WinUI 3 Progress Bar (Determinate & Indeterminate Modes) -->
            <StackPanel Spacing="6">
                <ProgressBar x:Name="SuiteProgressBar"
                             Value="0"
                             Maximum="100"
                             IsIndeterminate="False"
                             Height="6"
                             CornerRadius="3"
                             Foreground="#0078D4" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="DownloadMetricsText" Text="Ready (0 MB / 125 MB)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="1" x:Name="PercentageText" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>
            </StackPanel>

            <!-- Feature Badges -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Border Background="rgba(255,255,255,0.05)" BorderBrush="rgba(255,255,255,0.08)" BorderThickness="1" CornerRadius="16" Padding="10,4">
                    <TextBlock Text="✓ CastLabs Widevine CDM" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
                <Border Background="rgba(255,255,255,0.05)" BorderBrush="rgba(255,255,255,0.08)" BorderThickness="1" CornerRadius="16" Padding="10,4">
                    <TextBlock Text="✓ Built-in yt-dlp.exe" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
                <Border Background="rgba(255,255,255,0.05)" BorderBrush="rgba(255,255,255,0.08)" BorderThickness="1" CornerRadius="16" Padding="10,4">
                    <TextBlock Text="✓ WinUI 3 Native" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Bottom">
            <HyperlinkButton Content="https://github.com/codemolabs/Brave-Music" NavigateUri="https://github.com/codemolabs/Brave-Music" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button x:Name="SecondaryButton" Content="Documentation" Click="OnDocClicked" />
                <Button x:Name="PrimaryInstallButton"
                        Content="Install Brave Music"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnInstallButtonClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

